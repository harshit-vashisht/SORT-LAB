# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENAI_API_KEY: Optional API key for OpenAI GPT AI Mentor.
# Server reads this from environment variables.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# OPENAI_MODEL: Model to use for OpenAI completions (defaults to gpt-4o-mini).
OPENAI_MODEL="gpt-4o-mini"

# DEEPSEEK_API_KEY: Optional API key for DeepSeek AI Mentor (e.g. from https://platform.deepseek.com).
# Server connects to DeepSeek via official OpenAI-compatible endpoint.
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# DEEPSEEK_MODEL: DeepSeek model to use (defaults to deepseek-chat, or deepseek-reasoner).
DEEPSEEK_MODEL="deepseek-chat"


